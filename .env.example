# Copy to .env — read by docker compose and by the backend when run natively.

# Backend
GOOGLE_CLOUD_PROJECT=project_here
OPENAI_API_KEY=api_key_here
NEON_DB=postgres_connection_string_here
YOUR_NEON_API_KEY=api_key_here

# Frontend (baked into the bundle at docker build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
